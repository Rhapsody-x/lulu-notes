{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "噜噜便签",
  "version": "2.5.0",
  "identifier": "com.lulu.floatingnotes",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "噜噜便签",
        "width": 360,
        "height": 800,
        "x": 100,
        "y": 100,
        "resizable": false,
        "maximizable": false,
        "minimizable": false,
        "closable": true,
        "decorations": false,
        "transparent": true,
        "shadow": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "visible": false,
        "focus": true,
        "dragDropEnabled": false,
        "backgroundColor": [0, 0, 0, 0]
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": ["$APPDATA/**", "$APPLOCALDATA/**"]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "createUpdaterArtifacts": true,
    "category": "Productivity",
    "shortDescription": "桌面悬浮便签",
    "longDescription": "噜噜便签桌面版：悬浮球、富文本便签、搜索、回收站与导出。",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png",
      "icons/icon.ico"
    ],
    "windows": {
      "wix": {
        "language": "zh-CN"
      },
      "nsis": {
        "languages": ["SimpChinese"],
        "displayLanguageSelector": false
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDIxQjI3Qzk5QTZBNTc5MjQKUldRa2VhV21tWHl5SWJPUHU4UlhMMDNCSHNQVms1UjFORnZqVDdtQWF4ZlI5Yk0wNm1iRDJERHEK",
      "endpoints": [
        "https://gitee.com/xu0523/lulu-notes/raw/master/latest.json",
        "https://github.com/Rhapsody-x/lulu-notes/releases/latest/download/latest.json"
      ],
      "requireSignedVersion": true,
      "windows": {
        "installMode": "quiet"
      }
    }
  }
}
